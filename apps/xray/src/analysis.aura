# AURA X-RAY — current-main-safe native analysis contract.
# This is REAL Aura source compiled through aura-backend-c into the Windows EXE.
# No main() here: the minimal Win32 collection host calls these Aura functions.
# Units are explicitly defined; no claimed formal proof of these functions.

# Returns full 256-MiB quanta of a Windows process working set.
# 0..255 MiB => 0; 256..511 MiB => 1; etc.
cell xray_memory_quanta_256m(working_set_mib: u32):
    yield working_set_mib / 256

# Returns full 64-MiB quanta of cumulative process read IO.
# Cumulative counter, NOT a per-second rate.
cell xray_io_read_quanta_64m(io_read_kib: u32):
    yield io_read_kib / 65536

# Returns a 1,024-KiB resolution; helps exercise non-constant Aura logic.
cell xray_working_set_mib(working_set_kib: u32):
    yield working_set_kib / 1024

# XR-02 temporal analysis: callers must supply elapsed_ms > 0, counter deltas
# known monotonic and deltas <= 4294967 KiB to avoid uint32 overflow.
# Units are KiB/second (whole integer, conservative truncation).
cell xray_read_kib_per_sec(delta_kib: u32, elapsed_ms: u32):
    yield (delta_kib * 1000) / elapsed_ms

# 1000 millicores = 100% of ONE logical CPU. Values may exceed 1000.
cell xray_cpu_millicores(delta_cpu_ms: u32, elapsed_ms: u32):
    yield (delta_cpu_ms * 1000) / elapsed_ms

# Transparent ACTIVITY index (NOT ML/anomaly proof).
# CPU 100 millicores = 1 point; read/write 2048 KiB/s = 1 point each;
# 1 MiB positive working-set growth = 2 points. No negative growth bonus.
# Only called on complete, identity-validated comparable vectors.
cell xray_activity_score(cpu_milli: u32, read_kib_s: u32, write_kib_s: u32, growth_mib: u32):
    yield (cpu_milli / 100) + (read_kib_s / 2048) + (write_kib_s / 2048) + (growth_mib * 2)

# XR-03 evidence decomposition. These terms are ACTUAL AURA product logic,
# not reimplemented by the offline HTML viewer or the Windows adapter.
cell xray_cpu_impact(cpu_milli: u32):
    yield cpu_milli / 100

cell xray_io_impact(read_kib_s: u32, write_kib_s: u32):
    yield (read_kib_s / 2048) + (write_kib_s / 2048)

# growth_mib validated and bounded <= 16384 by the native caller.
cell xray_memory_impact(growth_mib: u32):
    yield growth_mib * 2

# XR-05 / Investigator — all behavioral thresholds are actual compiled Aura.
# C handles only observed process identity, sample ordering and evidence transport.
# None of these gates establishes causation, leaks, or a security diagnosis.
# A growth delta of 32768 KiB or more is a noteworthy memory pulse.
cell xray_burst_gate(growth_kib: u32):
    yield growth_kib / 32768

# Caller proves burst_kib >= 32768 and retraction_kib >= 0.
# Gate is true when the net retraction is >= half the original burst.
cell xray_recovery_gate(retraction_kib: u32, burst_kib: u32):
    yield retraction_kib / (burst_kib / 2)

# CPU >= 700 millicores = >=70% of one core for this sample.
cell xray_cpu_hot_gate(cpu_millicores: u32):
    yield cpu_millicores / 700

# Require at least 3 consecutive comparable high-CPU samples.
cell xray_cpu_streak_gate(consecutive_samples: u32):
    yield consecutive_samples / 3

# Transfer surge in either direction >= 16384 KiB/s.
# This is process I/O transfer, not guaranteed physical disk throughput.
cell xray_transfer_surge_gate(read_kib_s: u32, write_kib_s: u32):
    yield (read_kib_s / 16384) + (write_kib_s / 16384)


# XR-06 / Aura Temporal State Machine
# The caller supplies ordered observations and verified process identity. All
# recurrence, closure and multi-signal decisions below execute compiled Aura.
# No branch is a diagnosis: it only describes measured sample evidence.

# A hot-CPU streak resets on a missing observation, and starts at one if the
# same process reappears after a sample gap. The count is bounded to 4096.
cell xray06_cpu_streak_next(previous: u32, cpu_milli: u32, comparable: u32, adjacent: u32):
    val mut next: u32 = 0
    if comparable == 1:
        if cpu_milli >= 700:
            if adjacent == 1:
                if previous < 4096:
                    next = previous + 1
                else:
                    next = 4096
            else:
                next = 1
    yield next

# Equivalent independent state machine for consecutive I/O transfer surges.
cell xray06_io_streak_next(previous: u32, read_kib_s: u32, write_kib_s: u32, comparable: u32, adjacent: u32):
    val mut next: u32 = 0
    if comparable == 1:
        if read_kib_s >= 16384:
            if adjacent == 1:
                if previous < 4096:
                    next = previous + 1
                else:
                    next = 4096
            else:
                next = 1
        else:
            if write_kib_s >= 16384:
                if adjacent == 1:
                    if previous < 4096:
                        next = previous + 1
                    else:
                        next = 4096
                else:
                    next = 1
    yield next

# Outstanding working-set debt is the required half-burst contraction,
# adjusted for later positive and negative changes. The adapter MUST prove
# previous+growth <= UINT32_MAX and that all magnitudes are valid u32.
cell xray06_memory_remaining(previous: u32, growth: u32, reduction: u32):
    val mut remaining: u32 = previous + growth
    if reduction >= remaining:
        remaining = 0
    else:
        remaining = remaining - reduction
    yield remaining

# States: 1 pending, 2 observed >=half retraction, 3 bounded window elapsed,
# 4 continuity lost or counter uncertain. No false "recovered" at missing data.
cell xray06_memory_phase(previous: u32, remaining: u32, age: u32, evidence_ok: u32):
    val mut phase: u32 = previous
    if previous == 1:
        if evidence_ok == 0:
            phase = 4
        else:
            if remaining == 0:
                phase = 2
            else:
                if age >= 3:
                    phase = 3
    yield phase

# Count synchronous measured dimensions: CPU-hot, I/O transfer surge,
# memory burst. Two or three co-occurring dimensions form a *coincidence* case,
# not evidence that one caused another.
cell xray06_signal_dimensions(cpu_milli: u32, read_kib_s: u32, write_kib_s: u32, growth_kib: u32):
    val mut dimensions: u32 = 0
    if cpu_milli >= 700:
        dimensions = dimensions + 1
    if read_kib_s >= 16384:
        dimensions = dimensions + 1
    else:
        if write_kib_s >= 16384:
            dimensions = dimensions + 1
    if growth_kib >= 32768:
        dimensions = dimensions + 1
    yield dimensions

# The provenance grade is generated by Aura from explicit evidence validity.
# 0=unknown, 1=complete sampled vector, 2=exactly source-rechecked,
# 3=exact-source and uninterrupted across the episode.
cell xray06_evidence_grade(comparable: u32, raw_verified: u32, contiguous: u32):
    val mut grade: u32 = 0
    if comparable == 1:
        grade = 1
        if raw_verified == 1:
            grade = 2
            if contiguous == 1:
                grade = 3
    yield grade
